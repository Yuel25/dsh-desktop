{
  "name": "dsh-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "dsh-desktop — DeepSeek Harness Desktop Client",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "electron",
    "desktop"
  ],
  "homepage": "https://github.com/Yuel25/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/Yuel25/dsh-desktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuel25/dsh-desktop.git"
  },
  "license": "MIT",
  "author": "Yuel25",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "pnpm run typecheck && pnpm run build",
    "preview": "electron-vite preview",
    "dist": "pnpm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "build": {
    "appId": "io.github.yuel25.dsh-desktop",
    "productName": "dsh-desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
